{
  "name": "research-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A two-agent (researcher + advisor) research assistant loop built on pi-agent-core, running in separate Docker sandboxes.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "agent": "node agent/main.mjs",
    "orchestrate": "node orchestrator/run.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "typebox": "1.3.7"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true
  }
}

# Single image used by both agent roles (researcher and advisor).
#
# Agents can install extra tooling at runtime (passwordless sudo, as the
# non-root `agent` user). Installs are ephemeral: each run gets a fresh
# container.
#
# Optional build args bake commonly-needed toolchains in, so agents don't have
# to compile/install them in every run. Leave them at their default (0) for the
# slim base image, or bake a "toolbox" image:
#   docker build -f Dockerfile.agent \
#     --build-arg INSTALL_RUST=1 \
#     --build-arg INSTALL_UV=1 \
#     --build-arg INSTALL_LATEX=1 \
#     --build-arg INSTALL_NODE=1 \
#     --build-arg INSTALL_PLAYWRIGHT=1 \
#     -t research-loop-agent-toolbox:latest .
# Pass it to runs with `--image research-loop-agent-toolbox:latest`.

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV HOME=/home/agent
# skills.sh CLI opt-out (used by the install_skill tool).
ENV DISABLE_TELEMETRY=1

ARG INSTALL_RUST=0
ARG INSTALL_UV=0
ARG INSTALL_LATEX=0
ARG INSTALL_NODE=0
ARG INSTALL_PLAYWRIGHT=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        wget \
        git \
        jq \
        unzip \
        zip \
        file \
        ripgrep \
        less \
        vim-tiny \
        procps \
        sudo \
        util-linux \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Optional: light LaTeX toolbox (pdfLaTeX + common formats/fonts), enough for
# papers and TikZ figures. Skipped by default to keep the base image slim.
RUN if [ "$INSTALL_LATEX" = "1" ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends \
            texlive-latex-base \
            texlive-latex-recommended \
            texlive-fonts-recommended \
            texlive-pictures \
            latexmk \
            lmodern \
            cm-super \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Many skills/scripts assume `python`/`pip`; expose them as aliases.
RUN ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip

# Non-root agent user with passwordless sudo, so apt/pip installs work.
# The node:22 base already ships uid/gid 1000 as `node`, so rename it instead
# of creating a colliding user.
RUN groupmod -n agent node \
    && usermod -l agent -d /home/agent -m -g agent node \
    && echo 'agent ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/agent \
    && echo 'Defaults env_keep += "RUSTUP_HOME CARGO_HOME"' >> /etc/sudoers.d/agent \
    && echo 'Defaults secure_path = /home/agent/.local/bin:/opt/cargo/bin:/opt/nvm/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' >> /etc/sudoers.d/agent \
    && chmod 0440 /etc/sudoers.d/agent

# Keep the baked tool dirs on PATH for login shells and `sudo` (which reset
# PATH via /etc/profile / secure_path). Harmless in the slim base image.
RUN printf '%s\n' \
        'if [ -d /opt/cargo/bin ]; then export PATH="/opt/cargo/bin:$PATH"; fi' \
        'if [ -d "$HOME/.local/bin" ]; then export PATH="$HOME/.local/bin:$PATH"; fi' \
        'if [ -d /opt/rustup ]; then export RUSTUP_HOME=/opt/rustup; fi' \
        'if [ -d /opt/cargo ]; then export CARGO_HOME=/opt/cargo; fi' \
        'if [ -s /opt/nvm/nvm.sh ]; then export NVM_DIR=/opt/nvm; . "$NVM_DIR/nvm.sh" --no-use; fi' \
        'if [ -d /opt/nvm/current/bin ]; then export PATH="/opt/nvm/current/bin:$PATH"; fi' \
        > /etc/profile.d/research-loop-tools.sh

# Optional: Rust toolchain (rustup, stable) under /opt. Chowned to `agent` so
# subsequent cargo/rustup commands can self-update at runtime.
RUN if [ "$INSTALL_RUST" = "1" ]; then \
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
            RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo \
            sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path \
        && chown -R agent:agent /opt/rustup /opt/cargo; \
    fi
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH="/opt/cargo/bin:${PATH}"

# Optional: uv (Python toolchain manager) in the agent home, plus a couple of
# pre-installed CPython builds so `uv venv`/`uv run` don't download at run time.
# Owned by `agent` so uv can self-update/cache as that user.
RUN if [ "$INSTALL_UV" = "1" ]; then \
        curl -LsSf https://astral.sh/uv/install.sh | HOME=/home/agent sh \
        && mkdir -p /home/agent/.local /home/agent/.cache \
        && chown -R agent:agent /home/agent/.local /home/agent/.cache \
        && su - agent -c 'uv python install 3.11 3.12'; \
    fi
ENV PATH="/home/agent/.local/bin:${PATH}"

# Optional: nvm (Node Version Manager) under /opt/nvm, plus the latest Node.js
# LTS as its default. Agent login shells get that LTS `node`/`npm` first on PATH
# (via the /opt/nvm/current symlink) and can `nvm install`/`nvm use` others; the
# harness itself keeps running on the base image's Node.js 22. Owned by `agent`
# so nvm can install further versions at runtime.
ARG NVM_VERSION=v0.40.8
RUN if [ "$INSTALL_NODE" = "1" ]; then \
        mkdir -p /opt/nvm \
        && curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | \
            NVM_DIR=/opt/nvm PROFILE=/dev/null bash \
        && bash -c '. /opt/nvm/nvm.sh \
            && nvm install --lts --default \
            && ln -sfn "$(dirname "$(dirname "$(nvm which default)")")" /opt/nvm/current \
            && nvm cache clear' \
        && chown -R agent:agent /opt/nvm; \
    fi

# Optional: Playwright with Chromium pre-downloaded into $PLAYWRIGHT_BROWSERS_PATH
# and its native libraries apt-installed (`--with-deps`). The `playwright` CLI is
# installed globally (under the nvm LTS Node.js when INSTALL_NODE=1) and its
# version is exported as PLAYWRIGHT_VERSION, so projects can
# `npm i playwright@$PLAYWRIGHT_VERSION` and reuse the baked browser.
RUN if [ "$INSTALL_PLAYWRIGHT" = "1" ]; then \
        bash -lc 'npm install -g playwright@latest \
            && playwright install --with-deps chromium \
            && echo "export PLAYWRIGHT_VERSION=$(playwright --version | awk "{print \$2}")" \
                > /etc/profile.d/research-loop-playwright.sh' \
        && rm -rf /var/lib/apt/lists/* /home/agent/.npm \
        && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH"; \
    fi

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# skills.sh CLI for the install_skill tool (agents install skills at runtime).
RUN npm install -g skills@latest && rm -rf /home/agent/.npm

COPY agent/ ./agent/
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Mount targets (host bind mounts override these) created up-front and owned by
# the agent user so non-root writes work even without HOST_UID remapping.
RUN mkdir -p /sandbox /transcripts /config /researcher-sandbox /agent-run \
    && chown -R agent:agent /sandbox /transcripts /config /researcher-sandbox /agent-run /app

ENTRYPOINT ["/app/docker-entrypoint.sh"]
